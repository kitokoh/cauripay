# =============================================================================
# CauriPay — configuration d'environnement (copier vers .env et ajuster)
# 26 variables documentées. Toute variable manquante = démarrage refusé
# (fail-fast). Vérification : `make validate-env`.
# =============================================================================

# ---------------------------------------------------------------------------
# Infrastructure (docker-compose)
# ---------------------------------------------------------------------------
# Postgres 16
POSTGRES_USER=cauripay
POSTGRES_PASSWORD=cauripay_dev_password
POSTGRES_DB=cauripay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis 7
REDIS_PASSWORD=cauripay_dev_password
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ 4 (management sur :15672)
RABBITMQ_USER=cauripay
RABBITMQ_PASSWORD=cauripay_dev_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Keycloak 24 (admin console sur :8080)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=goursi
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/goursi/protocol/openid-connect/certs

# ---------------------------------------------------------------------------
# ledger-service (Java / Spring Boot 3.2) — cœur comptable
# ---------------------------------------------------------------------------
LEDGER_PORT=8100
LEDGER_DB_URL=jdbc:postgresql://localhost:5432/cauripay
LEDGER_REDIS_URL=redis://:cauripay_dev_password@localhost:6379/0
LEDGER_RABBITMQ_URL=amqp://cauripay:cauripay_dev_password@localhost:5672
# Clé interne partagée (X-Service-Key) — GÉNÉRER en production : openssl rand -hex 32
LEDGER_SERVICE_KEY=dev-service-key-change-me

# ---------------------------------------------------------------------------
# api-core (NestJS) — orchestration, auth, transactions
# ---------------------------------------------------------------------------
API_CORE_PORT=8000
DATABASE_URL=postgresql://cauripay:cauripay_dev_password@localhost:5432/cauripay
LEDGER_BASE_URL=http://localhost:8100
