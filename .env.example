# =============================================================================
# CauriPay — Variables d'environnement (monorepo)
# Copier vers .env et ajuster. Les valeurs ci-dessous sont des exemples DEV.
# Jamais de secret réel committé. Voir docs/SECURITY.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données (Postgres 16 — docker-compose)
# -----------------------------------------------------------------------------

# URL JDBC du ledger-service (schéma ledger géré par Flyway uniquement)
LEDGER_DATABASE_URL=jdbc:postgresql://localhost:5432/cauripay

# Utilisateur / mot de passe Postgres (dev : postgres / postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# URL Prisma / pg pour les services NestJS (api-core, business, …)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cauripay

# -----------------------------------------------------------------------------
# Infrastructure (docker-compose)
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=goursi
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Port HTTP du ledger-service (Spring Boot)
LEDGER_PORT=8081
# Port HTTP par défaut des services NestJS
API_CORE_PORT=3000
BUSINESS_PORT=3001
KYC_PORT=3002
AML_PORT=3003
NOTIFICATION_PORT=3004
USSD_PORT=3005
RECONCILIATION_PORT=3006
DEV_GATEWAY_PORT=3007

# -----------------------------------------------------------------------------
# Auth (JWT Keycloak RS256)
# -----------------------------------------------------------------------------

# URL JWKS/issuer Keycloak pour valider les tokens (les services NestJS)
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/goursi/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8080/realms/goursi

# Client/service account api-core (flux machine-to-machine)
KEYCLOAK_CLIENT_ID=api-core
KEYCLOAK_CLIENT_SECRET=dev-only-client-secret

# -----------------------------------------------------------------------------
# Sécurité inter-services
# -----------------------------------------------------------------------------

# Clé partagée X-Service-Key entre services (comparaison temps constant côté Java).
# OBLIGATOIRE en staging/prod — générer via `openssl rand -hex 32`. Dev : valeur d'exemple.
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me

# -----------------------------------------------------------------------------
# Notifications (dev : logs simulés)
# -----------------------------------------------------------------------------

# Clé API Twilio (SMS) — vide en dev (simulation)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+23500000000

# Clé API Firebase Cloud Messaging (push)
FCM_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Observabilité
# -----------------------------------------------------------------------------

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Application (divers)
# -----------------------------------------------------------------------------

# NODE_ENV : development | test | staging | production
NODE_ENV=development
# Niveau de log des services NestJS (log, error, warn, debug, verbose)
LOG_LEVEL=debug
# CORS autorisé pour les apps web (séparé par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
