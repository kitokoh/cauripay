# CauriPay — configuration (copier vers .env)

# Serveur
PORT=4000
HOST=0.0.0.0

# Secret JWT du dashboard (GÉNÉRER un secret aléatoire en production : openssl rand -hex 32)
JWT_SECRET=dev-secret-change-me

# Chemin de la base SQLite (optionnel)
# DATABASE_PATH=./data/cauripay.db

# URL publique (utilisée pour construire les checkout_url)
# PUBLIC_BASE_URL=https://api.cauripay.com
