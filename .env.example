# GOURSI — configuration de l'environnement
# Copier vers `.env` : `cp .env.example .env`
# Règle : AUCUN secret réel ici (gitleaks CI, 0 finding). Générer vos valeurs avec `openssl rand -hex 32`.

# ── Infrastructure ────────────────────────────────────────────────────────────
POSTGRES_USER=goursi
POSTGRES_PASSWORD=goursi_dev_password
POSTGRES_DB=goursi
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://goursi:goursi_dev_password@rabbitmq:5672
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=goursi
KEYCLOAK_CLIENT_SECRET=dev-client-secret
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000

# ── Clé interne inter-services (X-Service-Key) ────────────────────────────────
# Même valeur pour tous les services d'un même environnement. Staging ≠ prod.
INTERNAL_SERVICE_KEY=dev_internal_service_key_change_me

# ── Bases de données par service ──────────────────────────────────────────────
LEDGER_DATABASE_URL=jdbc:postgresql://localhost:5432/goursi_ledger
DATABASE_URL=postgresql://goursi:goursi_dev_password@postgres:5432/goursi_api_core
BUSINESS_DATABASE_URL=postgresql://goursi:goursi_dev_password@postgres:5432/goursi_business
KYC_DATABASE_URL=postgresql://goursi:goursi_dev_password@postgres:5432/goursi_kyc
AML_DATABASE_URL=postgresql://goursi:goursi_dev_password@postgres:5432/goursi_aml
NOTIFICATION_DATABASE_URL=postgresql://goursi:goursi_dev_password@postgres:5432/goursi_notification
RECONCILIATION_DATABASE_URL=postgresql://goursi:goursi_dev_password@postgres:5432/goursi_reconciliation
DEV_GATEWAY_DATABASE_URL=postgresql://goursi:goursi_dev_password@postgres:5432/goursi_dev_gateway

# ── Ports services (convention ADR-004) ───────────────────────────────────────
API_CORE_PORT=3000
LEDGER_PORT=3010
BUSINESS_PORT=3020
KYC_PORT=3030
AML_PORT=3040
NOTIFICATION_PORT=3050
USSD_PORT=3060
RECONCILIATION_PORT=3070
DEV_GATEWAY_PORT=3080
WEB_ADMIN_PORT=3001
WEB_BUSINESS_PORT=3002

# ── Keycloak JWT (validation RS256) ───────────────────────────────────────────
JWT_ISSUER=http://keycloak:8080/realms/goursi
JWKS_URL=http://keycloak:8080/realms/goursi/protocol/openid-connect/certs

# ── Secrets applicatifs (générer en réel) ─────────────────────────────────────
JWT_SECRET=dev-secret-change-me
WEBHOOK_SIGNING_SECRET=dev-webhook-secret-change-me
KYC_ENCRYPTION_KEY=dev-kyc-encryption-key-change-me-32bytes!
# OTP / SMS (fournisseur configuré en staging)
SMS_PROVIDER_URL=
SMS_API_KEY=
FCM_SERVER_KEY=

# ── ledger-service (Spring) ───────────────────────────────────────────────────
LEDGER_IDEMPOTENCY_TTL_HOURS=24
LEDGER_CHECKPOINT_CRON=0 0 2 * * *
