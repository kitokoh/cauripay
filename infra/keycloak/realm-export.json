      "webOrigins": ["http://localhost:3000"]
    },
    {
      "clientId": "web-admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4000/*"],
      "webOrigins": ["http://localhost:4000"]
    },
    {
      "clientId": "web-business",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5000/*"],
      "webOrigins": ["http://localhost:5000"]
    }
  ],
  "defaultRoles": ["CUSTOMER"],
  "users": [
    {
      "username": "admin@cauripay.test",
      "email": "admin@cauripay.test",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["SUPER_ADMIN", "CUSTOMER"]
