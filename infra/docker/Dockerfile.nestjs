# ── Étapes ─────────────────────────────────────────────────────────────────────
# build : node:22-alpine, npm ci, compilation TS
# runtime : node:22-alpine, npm ci --omit=dev, dist seul, user non-root (uid 1000)
# Usage : docker build -f infra/docker/Dockerfile.nestjs services/<nom-service>
# Règle : l'image reçoit BUILD_SERVICE=<nom> pour cibler le workspace.

FROM node:22-alpine AS build
WORKDIR /app
ARG BUILD_SERVICE
ENV BUILD_SERVICE=${BUILD_SERVICE}
# 1. Dépendances (cache de couches : package*.json d'abord)
COPY package.json package-lock.json ./
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/validation-rules/package.json packages/validation-rules/
COPY services/${BUILD_SERVICE}/package.json services/${BUILD_SERVICE}/
RUN npm ci --no-audit --no-fund --ignore-scripts --workspace=@goursi/${BUILD_SERVICE} || npm ci --no-audit --no-fund --ignore-scripts
# 2. Sources
COPY packages packages
COPY services/${BUILD_SERVICE} services/${BUILD_SERVICE}
COPY tsconfig.base.json ./
# Génération Prisma (si le service expose un schéma) — le postinstall est
# ignoré ci-dessus car le schéma n'est pas encore copié.
RUN if [ -f services/${BUILD_SERVICE}/prisma/schema.prisma ]; then npx prisma generate --schema services/${BUILD_SERVICE}/prisma/schema.prisma; fi
RUN npm run build --workspace=@goursi/${BUILD_SERVICE} || npx tsc -p services/${BUILD_SERVICE}/tsconfig.json

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S -g 1001 goursi && adduser -S -u 1001 -G goursi goursi
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/services/${BUILD_SERVICE}/dist ./dist
COPY --from=build /app/services/${BUILD_SERVICE}/package.json ./package.json
USER goursi
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:${PORT:-3000}/health || exit 1
CMD ["node", "dist/main.js"]
