  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Disponibilité des jobs scrappés par Prometheus (ledger-service, api-core, prometheus).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "expr": "up", "legendFormat": "{{job}}" } ],
      "title": "Services up (scrape Prometheus)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(ledger_transfers_total[5m]))", "legendFormat": "transferts" },
        { "expr": "sum(rate(ledger_reversals_total[5m]))", "legendFormat": "reversals" }
      ],
      "title": "Activité ledger (ops/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(ledger_transfers_failed[5m]))", "legendFormat": "échecs" }
      ],
      "title": "Échecs ledger (ops/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Latence p95 des transferts ledger (objectif DoD #7 : p95 < 2 s).",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(ledger_transfer_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95 transfer" }
      ],
      "title": "Latence transfert ledger — p95 (cible < 2 s)",
      "type": "timeseries"
    }
