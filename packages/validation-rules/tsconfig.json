{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@goursi/shared-types": [
        "../shared-types/dist/index.d.ts"
      ],
      "@goursi/shared-types/*": [
        "../shared-types/dist/*"
      ]
    },
    "declaration": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/__tests__",
    "src/**/*.spec.ts"
  ]
}
