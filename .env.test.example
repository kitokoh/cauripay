# =============================================================================
# CauriPay — Variables d'environnement pour les tests (CI / jest)
# Valeurs déterministes, aucun secret réel.
# =============================================================================

NODE_ENV=test
LOG_LEVEL=silent

LEDGER_DATABASE_URL=jdbc:postgresql://localhost:5432/cauripay_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cauripay_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_URL=redis://localhost:6379/15
RABBITMQ_URL=amqp://guest:guest@localhost:5672

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=goursi
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/goursi/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8080/realms/goursi
KEYCLOAK_CLIENT_ID=api-core
KEYCLOAK_CLIENT_SECRET=test-client-secret

LEDGER_PORT=8081
API_CORE_PORT=3000
BUSINESS_PORT=3001
KYC_PORT=3002
AML_PORT=3003
NOTIFICATION_PORT=3004
USSD_PORT=3005
RECONCILIATION_PORT=3006
DEV_GATEWAY_PORT=3007

INTERNAL_SERVICE_KEY=test-internal-service-key

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FCM_SERVICE_ACCOUNT_JSON=

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

CORS_ORIGINS=http://localhost:3000
