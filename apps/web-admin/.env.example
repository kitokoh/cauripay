# web-admin — configuration locale (copier vers apps/web-admin/.env.local)
# Aucun secret réel ici — générer avec `openssl rand -hex 32` en staging/prod.

# Port du back-office (convention ADR-004)
WEB_ADMIN_PORT=3001

# Keycloak OIDC
JWT_ISSUER=http://localhost:8080/realms/goursi
KEYCLOAK_CLIENT_ID=web-admin
KEYCLOAK_CLIENT_SECRET=dev-client-secret

# Chiffrement de la session (JWE) — requis en production
SESSION_SECRET=dev-web-admin-session-secret-change-me

# api-core
API_CORE_BASE_URL=http://localhost:3000
INTERNAL_SERVICE_KEY=dev_internal_service_key_change_me
