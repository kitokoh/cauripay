# Portail entreprises (ADR-004 : port 3002)
WEB_BUSINESS_PORT=3002

# OIDC — Keycloak realm `goursi`, client public `web-business` (infra/keycloak/realm-export.json)
OIDC_ISSUER_URL=http://localhost:8080/realms/goursi
OIDC_CLIENT_ID=web-business
OIDC_REDIRECT_URI=http://localhost:3002/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3002/login

# Session (JWT signé HS256, cookie `goursi_business_session`) — >= 32 caractères
SESSION_SECRET=change-me-min-32-characters-please
SESSION_MAX_AGE_H=8

# business-service (GOURSI-030+) — appels internes authentifiés X-Service-Key
BUSINESS_SERVICE_URL=http://localhost:3020
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
