// CauriPay api-core — schéma Prisma (spec §4.4)
// Le solde des wallets vit dans ledger-service (JAMAIS ici) — les wallets
// ici ne portent que l'identité et les références de comptabilité.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycLevel {
  BASIC
  VERIFIED
  PREMIUM
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletType {
  CUSTOMER
  MERCHANT
  AGENT
  DISTRIBUTOR
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REVERSED
}

enum TransactionType {
  P2P
  CASH_IN
  CASH_OUT
  BILL_PAYMENT
  MERCHANT_PAYMENT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  phone        String   @unique
  email        String?  @unique
  fullName     String?
  passwordHash String
  mPinHash     String?
  kycLevel     KycLevel @default(BASIC)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallets   Wallet[]
  kycRecord KycRecord?
  sent      Transaction[] @relation("SentTransactions")
  received Transaction[] @relation("ReceivedTransactions")
}

model Wallet {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  type       WalletType   @default(CUSTOMER)
  currency   String       @default("XAF")
  status     WalletStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@index([userId])
}

model KycRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  status      String   @default("PENDING") // PENDING | VALIDATED | REJECTED
  level       KycLevel @default(BASIC)
  documents   Json     @default("[]") // références chiffrées AES-256 (kyc-service)
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?  @db.Uuid

  user User @relation(fields: [userId], references: [id])
}

model Transaction {
  id               String            @id @default(uuid()) @db.Uuid
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  amount           Decimal           @db.Decimal(15, 2)
  feeAmount        Decimal           @default(0) @db.Decimal(15, 2)
  currency         String            @default("XAF")
  senderId         String?           @db.Uuid
  receiverId       String?           @db.Uuid
  ledgerRef        String? // transactionId ledger (idempotence)
  idempotencyKey   String?           @unique
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  sender   User? @relation("SentTransactions", fields: [senderId], references: [id])
  receiver User? @relation("ReceivedTransactions", fields: [receiverId], references: [id])

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([status])
}
