// GOURSI — schéma Prisma api-core (spec §4.4)
// Règle : JAMAIS de solde ici — la vérité des soldes est dans ledger-service.
generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/api-core-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MERCHANT
  AGENT
  DISTRIBUTOR
  SUPER_ADMIN
  COMPLIANCE_OFFICER
  SUPPORT_L1
  SUPPORT_L2
  FINANCE_MANAGER
  OPS_AGENT_MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
  CLOSED
}

enum KycLevel {
  BASIC
  VERIFIED
  PREMIUM
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WalletType {
  CUSTOMER
  AGENT
  AGENT_FLOAT
  MERCHANT
  PLATFORM_FEES
  PLATFORM_REVENUE
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REVERSED
}

enum TransactionType {
  P2P
  CASH_IN
  CASH_OUT
  BILL_PAYMENT
  MERCHANT_PAYMENT
}

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  fullName      String
  email         String?   @unique
  passwordHash  String
  mPinHash      String?
  role          UserRole  @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  kycLevel      KycLevel  @default(BASIC)
  phoneVerified Boolean   @default(false)
  keycloakSub   String?   @unique
  failedAttempts Int      @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wallets       Wallet[]
  kycRecords    KycRecord[]
  transactionsSent  Transaction[] @relation("Sender")
  transactionsReceived Transaction[] @relation("Recipient")
  auditLogs     AuditLog[]
  otps          Otp[]
}

model Wallet {
  id            String    @id @default(uuid())
  accountNumber String    @unique
  type          WalletType @default(CUSTOMER)
  status        WalletStatus @default(ACTIVE)
  ownerId       String?
  owner         User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  alertThreshold Decimal?  @db.Decimal(15, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactionsSent Transaction[] @relation("WalletSender")
  transactionsReceived Transaction[] @relation("WalletRecipient")

  @@index([ownerId])
}

model KycRecord {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedLevel KycLevel
  status        KycStatus @default(PENDING)
  documentsEncrypted Json?   // { type, ciphertext, iv } — AES-256
  rejectionReason String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
}

model Transaction {
  id            String    @id @default(uuid())
  idempotencyKey String   @unique
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amountMinor   Decimal   @db.Decimal(15, 2) // Prisma.Decimal — jamais float
  feeAmountMinor Decimal  @db.Decimal(15, 2) @default(0)
  currency      String    @default("XAF")
  senderId      String?
  sender        User?     @relation("Sender", fields: [senderId], references: [id], onDelete: SetNull)
  recipientId   String?
  recipient     User?     @relation("Recipient", fields: [recipientId], references: [id], onDelete: SetNull)
  senderWalletId String?
  senderWallet  Wallet?   @relation("WalletSender", fields: [senderWalletId], references: [id], onDelete: SetNull)
  recipientWalletId String?
  recipientWallet Wallet? @relation("WalletRecipient", fields: [recipientWalletId], references: [id], onDelete: SetNull)
  statusReason  String?
  failureReason String?
  description   String?
  metadata      Json?
  processedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([status])
}

model AuditLog {
  id            String    @id @default(uuid())
  resourceType  String
  resourceId    String
  action        String
  actorId       String?
  actor         User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  details       Json?
  createdAt     DateTime  @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model Otp {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String
  purpose       String // LOGIN, CASH_IN, CASH_OUT, MPIN_RESET
  expiresAt     DateTime
  consumedAt    DateTime?
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([userId, purpose])
}
