<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Checkstyle minimal pour ledger-service (EPIC-G1).
  Priorité : montants BigDecimal (jamais float), immuabilité, lisibilité.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>

  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="ignorePattern" value="^import |^\s*\* @"/>
  </module>

  <module name="TreeWalker">
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="OneTopLevelClass"/>
    <module name="IllegalType">
      <property name="illegalClassNames" value="java.lang.Double, java.lang.Float"/>
      <property name="tokens" value="METHOD_DEF, PARAMETER_DEF, VARIABLE_DEF, FIELD_DEF, RECORD_DEF, CLASS_DEF"/>
      <message key="illegal.type" value="Montants/intervalles : BigDecimal requis — jamais double/float (liste rouge #1)."/>
    </module>
    <module name="VisibilityModifier">
      <property name="packageAllowed" value="false"/>
    </module>
    <module name="FinalClass"/>
    <module name="HideUtilityClassConstructor"/>
    <module name="MissingOverride"/>
    <module name="DefaultComesLast"/>
    <module name="NeedBraces"/>
    <module name="EqualsHashCode"/>
    <module name="StringLiteralEquality"/>
    <module name="NoFinalizer"/>
  </module>
</module>
