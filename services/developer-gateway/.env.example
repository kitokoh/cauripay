# GOURSI — developer-gateway (port 3080, DEV_GATEWAY_PORT)
# Copier vers .env : cp .env.example .env — AUCUN secret réel (CI gitleaks, 0 finding).

NODE_ENV=development
DEV_GATEWAY_PORT=3080

# Postgres (même instance que api-core ; tables developer-gateway dédiées)
DATABASE_URL=postgresql://goursi:goursi_dev_password@postgres:5432/goursi_api_core

# Redis — fenêtre glissante du rate limiting par clé (1000 req/min)
REDIS_URL=redis://redis:6379

# RabbitMQ — DLQ des webhooks échoués (dead.letters / failed.webhooks)
RABBITMQ_URL=amqp://goursi:goursi_dev_password@rabbitmq:5672

# Clé interne inter-services (X-Service-Key) — min 16 caractères
INTERNAL_SERVICE_KEY=dev_internal_service_key_change_me

# JWT — RS256 via JWKS (Keycloak) ; JWT_SECRET optionnel (fallback HS256 en dev)
JWT_ISSUER=http://keycloak:8080/realms/goursi
JWKS_URL=http://keycloak:8080/realms/goursi/protocol/openid-connect/certs
JWT_SECRET=dev_only_jwt_secret_change_me

# Secret de signature webhook (optionnel — utilisé pour les événements simulés)
WEBHOOK_SIGNING_SECRET=dev_only_webhook_secret_change_me

# CORS restreint (liste blanche, séparée par des virgules)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
