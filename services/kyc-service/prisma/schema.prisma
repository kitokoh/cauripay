// kyc-service — schéma Prisma (schéma `kyc` de la base partagée).
// Propriété : kyc-service uniquement (ADR-001 services dédiés).
// Les documents sont stockés CHIFFRÉS (AES-256-GCM) — jamais en clair (GOURSI-024a).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("KYC_DATABASE_URL")
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycLevel {
  BASIC
  VERIFIED
  PREMIUM
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  RESIDENCE_PERMIT
  OTHER
}

model KycRecord {
  id           String          @id @default(uuid())
  userId       String
  level        KycLevel
  documentType KycDocumentType
  status       KycStatus       @default(PENDING)
  reason       String? // motif de rejet / note
  // Documents chiffrés AES-256-GCM (payload {iv, tag, ciphertext} en base64)
  document     String // ciphertext base64 (document + iv + tag concaténés)
  selfie       String // ciphertext base64
  decidedBy    String? // userId de l'officier compliance
  decidedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, level])
  @@index([userId])
  @@index([createdAt])
}
