  "description": "notification-service — canaux SMS/Email/Push FCM/WhatsApp, consumer RabbitMQ, retry/backoff + DLQ (port 3050)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prisma:generate": "prisma generate",
