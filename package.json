{
  "name": "cauripay",
  "version": "0.2.0",
  "private": true,
  "description": "CauriPay — plateforme wallet & agrégation de paiement pour l'Afrique centrale et de l'Ouest. Monorepo : services NestJS + ledger Java, apps web/mobile, packages partagés.",
  "workspaces": [
    "services/*",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test-java": "mvn -B test --file services/ledger-service/pom.xml"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "license": "MIT"
}
