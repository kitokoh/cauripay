{
  "name": "goursi",
  "version": "0.2.0",
  "private": true,
  "description": "GOURSI — plateforme wallet CauriPay (monorepo) : ledger comptable, wallets, KYC/AML, mobile money, USSD.",
  "workspaces": [
    "services/*",
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run start:dev --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "clean": "rm -rf node_modules && npm run clean --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "lodash": "^4.18.1",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  },
  "overrides": {
    "lodash": "^4.18.1"
  }
}
