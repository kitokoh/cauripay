# CauriPay (legacy v0.1) — configuration (copier vers .env)

# Serveur
PORT=4000
HOST=0.0.0.0
# NODE_ENV=production   # active les garde-fous : JWT secret obligatoire, CORS restreint, anti-SSRF

# Secret JWT du dashboard (OBLIGATOIRE et aléatoire en production : openssl rand -hex 32)
JWT_SECRET=dev-secret-change-me

# Chemin de la base SQLite (optionnel)
# DATABASE_PATH=./data/cauripay.db

# URL publique (utilisée pour construire les checkout_url)
# PUBLIC_BASE_URL=https://api.cauripay.com

# CORS (production) : domaines autorisés, séparés par des virgules
# CORS_ORIGINS=

# Rate limiting
RATE_LIMIT_GLOBAL=300       # par IP (dashboard, checkout)
RATE_LIMIT_PER_KEY=1000     # par clé API sur /api/v1 (1 minute)

# Webhooks sortants — anti-SSRF
# ALLOW_PRIVATE_WEBHOOKS=true    # dev uniquement : autoriser 127.0.0.1 / réseau local
# ALLOW_INSECURE_WEBHOOKS=true   # dev uniquement : autoriser http en production
MAX_WEBHOOKS_PER_MERCHANT=10

# Checkout — anti-brute-force PIN
CHECKOUT_MAX_PIN_FAILURES=5
CHECKOUT_BLOCK_MINUTES=10
